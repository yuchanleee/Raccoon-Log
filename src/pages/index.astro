---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import RaccoonSprite from "@/assets/images/raccoon.png";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border relative border-b pt-8 pb-6">
      <div class="hero-content">
        <h1 class="my-4 inline-block text-2xl font-bold sm:my-8 sm:text-3xl">
          Raccoon's archive
        </h1>

        <div class="raccoon-frame">
          <div id="raccoon">
            <img id="raccoon-sprite" src={RaccoonSprite.src} alt="Raccoon" />
          </div>
        </div>

        <p class="text-lg">볼 것도 없는 곳인데, 뭘 그리 두리번거리는가?</p>

        {
          socials.length > 0 && (
            <div class="mt-4 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>

          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>

          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    const raccoonSprite = document.querySelector(
      "#raccoon-sprite"
    ) as HTMLElement;

    if (!raccoonSprite) return;

    const getFrameWidth = () => {
      return window.innerWidth <= 1100 ? 160 : 210;
    };

    const showFrame = (frame: number) => {
      const frameWidth = getFrameWidth();

      raccoonSprite.style.transform = `translateX(-${frame * frameWidth}px)`;
    };

    const wait = (ms: number) => {
      return new Promise(resolve => setTimeout(resolve, ms));
    };

    const blink = async () => {
      showFrame(1);
      await wait(40);

      showFrame(2);
      await wait(40);

      showFrame(3);
      await wait(40);

      showFrame(4);
      await wait(40);

      showFrame(5);
      await wait(40);

      showFrame(0);
    };

    const startBlinking = async () => {
      while (true) {
        const delay = 3000 + Math.random() * 2000;

        await wait(delay);
        await blink();
      }
    };

    startBlinking();
  });
</script>

<style>
  #hero {
    position: relative;
  }

  .hero-content {
    min-width: 0;
  }

  .raccoon-frame {
    position: absolute;
    top: calc(50% - 10px);
    left: -220px;

    width: 220px;
    height: 240px;

    transform: translateY(-50%);

    display: flex;
    align-items: flex-end;
    justify-content: center;

    overflow: hidden;
  }

  #raccoon {
    position: relative;

    width: 210px;
    height: 210px;

    overflow: hidden;

    left: 15px;
  }

  #raccoon-sprite {
    position: absolute;
    top: 0;
    left: 0;

    width: 1260px;
    height: 210px;

    max-width: none;

    image-rendering: pixelated;
  }

  @media (max-width: 1100px) {
    .raccoon-frame {
      position: static;

      width: 170px;
      height: 170px;

      margin-top: 0.5rem;
      transform: none;
    }

    #raccoon {
      width: 160px;
      height: 160px;
      left: 0;
    }

    #raccoon-sprite {
      width: 960px;
      height: 160px;
    }
  }

  @media (max-width: 639px) {
    .raccoon-frame {
      width: 100%;
    }
  }
</style>
