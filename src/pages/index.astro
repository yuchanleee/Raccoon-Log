---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import RaccoonSprite from "@/assets/images/raccoon.png";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b">
      <div class="raccoon-area">
        <div class="raccoon-frame">
          <div id="raccoon">
            <img id="raccoon-sprite" src={RaccoonSprite.src} alt="Raccoon" />
          </div>
        </div>

        <div class="raccoon-speech">
          어서 오시게. <br />
          천천히 둘러보게<div class=""></div>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>

          <ul class="mt-1">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>

          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="px-4 py-2"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }

    const raccoonSprite = document.querySelector(
      "#raccoon-sprite"
    ) as HTMLElement;

    if (!raccoonSprite) return;

    const FRAME_WIDTH = 210;

    const showFrame = (frame: number) => {
      raccoonSprite.style.transform = `translateX(-${frame * FRAME_WIDTH}px)`;
    };

    const wait = (ms: number) => {
      return new Promise(resolve => setTimeout(resolve, ms));
    };

    const blink = async () => {
      showFrame(1);
      await wait(40);

      showFrame(2);
      await wait(40);

      showFrame(3);
      await wait(40);

      showFrame(4);
      await wait(40);

      showFrame(5);
      await wait(40);

      showFrame(0);
    };

    const startBlinking = async () => {
      while (true) {
        const delay = 3000 + Math.random() * 2000;

        await wait(delay);
        await blink();
      }
    };

    startBlinking();
  });
</script>

<style>
  .raccoon-area {
    display: flex;
    align-items: center;
    gap: 1.5rem;

    padding-top: 3rem;
  }

  .raccoon-frame {
    width: 210px;
    height: 210px;

    flex-shrink: 0;
    overflow: hidden;
  }

  #raccoon {
    position: relative;

    width: 210px;
    height: 210px;

    overflow: hidden;
  }

  #raccoon-sprite {
    position: absolute;
    top: 0;
    left: 0;

    width: 1260px;
    height: 210px;

    max-width: none;

    image-rendering: pixelated;
  }

  .raccoon-speech {
    position: relative;

    padding: 0.75rem 1rem;

    border: 2px solid var(--border);
    border-radius: 8px;
    background: var(--background);

    font-size: 1rem;
    line-height: 1.6;

    transform: translateY(-80px);
  }

  .raccoon-speech::before {
    content: "";

    position: absolute;
    left: -10px;
    bottom: 24px;

    width: 18px;
    height: 18px;

    border-left: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    background: var(--background);

    transform: rotate(45deg);
  }
</style>
