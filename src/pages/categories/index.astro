---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import CategoryTree from "@/components/CategoryTree.astro";

import { buildCategoryTree } from "@/utils/buildCategoryTree";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const categoryPaths = posts.map(post => post.data.category);
const categoryTree = buildCategoryTree(categoryPaths);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.categories.title} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.categories.title} pageDesc={t.pages.categoriesDesc}>
    <CategoryTree tree={categoryTree} />
  </Main>

  <Footer />
</Layout>
