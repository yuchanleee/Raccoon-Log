---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import DesktopSearch from "./DesktopSearch.astro";
import MobileSearch from "./MobileSearch.astro";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="header-layout flex flex-col items-center justify-between">
  <div
    id="desktop-header"
    class="border-border bg-background relative w-full border-b py-4 min-[900px]:grid min-[900px]:grid-cols-[auto_minmax(0,1fr)] min-[900px]:items-center min-[900px]:gap-x-6 min-[900px]:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap min-[900px]:static min-[900px]:text-2xl min-[900px]:leading-none"
    >
      {site.title}
    </a>

    <nav
      class="hidden min-[900px]:grid min-[900px]:min-w-0 min-[900px]:grid-cols-[minmax(0,1fr)_auto] min-[900px]:items-center min-[900px]:gap-x-4"
      aria-label="Main navigation"
    >
      <ul
        class="desktop-text-nav flex min-w-0 items-center gap-x-6 justify-self-center xl:gap-x-8"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "hover:text-accent px-2 py-1 font-medium",
              { "active-nav": isActive("/posts") },
            ]}
          >
            {t.nav.posts}
          </a>
        </li>

        <li>
          <a
            href={getRelativeLocaleUrl(locale, "categories")}
            class:list={[
              "hover:text-accent px-2 py-1 font-medium",
              { "active-nav": isActive("/categories") },
            ]}
          >
            {t.nav.categories}
          </a>
        </li>

        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "hover:text-accent px-2 py-1 font-medium",
              { "active-nav": isActive("/about") },
            ]}
          >
            {t.nav.about}
          </a>
        </li>
      </ul>

      <ul class="flex shrink-0 items-center gap-x-4 xl:gap-x-6">
        {
          features.search !== false && (
            <li class="flex min-w-0 items-center">
              <DesktopSearch />
            </li>
          )
        }

        {
          features.showArchives && (
            <li class="shrink-0">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline relative flex size-8 items-center justify-center",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only">{t.nav.archives}</span>

                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125"
                  />
                )}
              </LinkButton>
            </li>
          )
        }

        {
          features.lightAndDarkMode && (
            <li class="flex shrink-0 items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline hover:[&>svg]:stroke-accent relative size-8"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>

    <nav
      id="nav-menu"
      class="flex w-full items-center justify-end min-[800px]:hidden"
    >
      {
        features.search !== false && (
          <button
            id="mobile-search-btn"
            class="focus-outline hover:[&>svg]:stroke-accent relative size-10"
            title={t.nav.search}
            aria-label={t.nav.search}
            aria-expanded="false"
          >
            <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
            <span class="sr-only">{t.nav.search}</span>
          </button>
        )
      }

      {
        features.showArchives && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "focus-outline relative flex size-10 items-center justify-center",
              { "active-nav": isActive("/archives") },
            ]}
            title={t.nav.archives}
            aria-label={t.nav.archives}
          >
            <IconArchive class="size-6" />
            <span class="sr-only">{t.nav.archives}</span>
          </LinkButton>
        )
      }

      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn-mobile"
            class="focus-outline hover:[&>svg]:stroke-accent relative size-10"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }

      <button
        id="menu-btn"
        class="focus-outline relative size-10"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX
          id="close-icon"
          class="absolute top-1/2 left-1/2 hidden size-6 -translate-x-1/2 -translate-y-1/2"
        />
        <IconMenuDeep
          id="menu-icon"
          class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2"
        />
      </button>

      <ul
        id="menu-items"
        class="border-border bg-background absolute top-full right-0 z-40 mt-2 hidden w-44 flex-col border p-2"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "hover:text-accent block px-4 py-3 font-medium",
              { "active-nav": isActive("/posts") },
            ]}
          >
            {t.nav.posts}
          </a>
        </li>

        <li>
          <a
            href={getRelativeLocaleUrl(locale, "categories")}
            class:list={[
              "hover:text-accent block px-4 py-3 font-medium",
              { "active-nav": isActive("/categories") },
            ]}
          >
            {t.nav.categories}
          </a>
        </li>

        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "hover:text-accent block px-4 py-3 font-medium",
              { "active-nav": isActive("/about") },
            ]}
          >
            {t.nav.about}
          </a>
        </li>
      </ul>
    </nav>
    <MobileSearch />
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("flex");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  function initMobileSearch() {
    const searchBtn =
      document.querySelector<HTMLButtonElement>("#mobile-search-btn");

    const searchPanel = document.querySelector<HTMLElement>(
      "#mobile-search-panel"
    );

    if (!searchBtn || !searchPanel) return;

    if (searchBtn.dataset.searchBound === "true") return;
    searchBtn.dataset.searchBound = "true";

    searchBtn.addEventListener("click", () => {
      const isOpen = searchBtn.getAttribute("aria-expanded") === "true";

      searchBtn.setAttribute("aria-expanded", isOpen ? "false" : "true");
      searchPanel.classList.toggle("hidden", isOpen);

      document.body.style.overflow = isOpen ? "" : "hidden";

      if (!isOpen) {
        const input = searchPanel.querySelector<HTMLInputElement>(
          ".pagefind-ui__search-input"
        );

        requestAnimationFrame(() => input?.focus());
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  initMobileSearch();
  document.addEventListener("astro:after-swap", initMobileSearch);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
