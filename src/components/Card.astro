---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import IconCategory from "@/assets/icons/IconCategory.svg";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, category, cover, ...props } = data;

const lowestCategory = category.at(-1);
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li
  class="mobile-tap-card mobile-tap-flash border-border border-b px-1 py-3 last-of-type:border-b-0 min-[900px]:py-0"
  data-post-url={postUrl}
>
  <div class="post-card">
    <div class="post-content">
      <a
        href={postUrl}
        class:list={[
          "text-accent inline-block text-xl font-medium min-[900px]:text-xl",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>

      <div class="mt-1 mb-2 flex items-center gap-5">
        <Datetime {...props} size="lg" />

        {
          lowestCategory && (
            <span class="text-muted-foreground flex items-center gap-1">
              <IconCategory class="size-5" />
              <span class="text-xs min-[900px]:text-lg">{lowestCategory}</span>
            </span>
          )
        }
      </div>

      <p class="min-[900px]:text-lg">{description}</p>
    </div>

    {
      cover && (
        <div class="post-cover-wrap">
          <img src={cover.src} alt="" class="post-cover" />
        </div>
      )
    }
  </div>
</li>

<script>
  import { navigate } from "astro:transitions/client";

  function initMobilePostCards() {
    const cards = document.querySelectorAll<HTMLElement>(".mobile-tap-card");

    for (const card of cards) {
      if (card.dataset.cardBound === "true") continue;

      card.dataset.cardBound = "true";

      card.addEventListener("click", event => {
        if (!window.matchMedia("(max-width: 899px)").matches) return;

        const target = event.target as HTMLElement;
        const url = card.dataset.postUrl;

        if (!url) return;

        if (target.closest("a")) return;

        navigate(url);
      });
    }
  }

  initMobilePostCards();
  document.addEventListener("astro:after-swap", initMobilePostCards);
</script>

<style>
  .post-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 160px;
  }

  .post-content {
    flex: 1;
    min-width: 0;
  }

  .post-cover-wrap {
    width: 160px;
    height: 160px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 10px;
  }

  .post-cover {
    width: auto;
    height: 100%;
    max-width: none;
  }

  @media (max-width: 899px) {
    .post-cover-wrap {
      position: relative;
    }

    .post-cover-wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      background-color: transparent;
      pointer-events: none;
    }

    .mobile-tap-flash.tap-flash .post-cover-wrap::after {
      background-color: color-mix(in srgb, var(--border) 65%, transparent);
    }
  }

  @media (max-width: 639px) {
    .post-card {
      min-height: 120px;
      gap: 1rem;
    }

    .post-cover-wrap {
      width: 120px;
      height: 120px;
    }
  }
</style>
