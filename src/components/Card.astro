---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import IconCategory from "@/assets/icons/IconCategory.svg";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, category, cover, ...props } = data;

const lowestCategory = category.at(-1);
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
---

<li
  class="mobile-tap-card mobile-tap-flash border-border my-8 border-b pb-8 last-of-type:border-b-0"
  data-post-url={postUrl}
>
  <div class="post-card">
    <div class="post-content">
      <a
        href={postUrl}
        class:list={[
          "text-accent inline-block text-xl font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>

      <div class="mt-1 mb-2 flex items-center gap-5">
        <Datetime {...props} />

        {
          lowestCategory && (
            <span class="text-muted-foreground flex items-center gap-1">
              <IconCategory class="size-5" />
              <span class="text-sm">{lowestCategory}</span>
            </span>
          )
        }
      </div>

      <p>{description}</p>
    </div>

    {cover && <img src={cover.src} alt="" class="post-cover" />}
  </div>
</li>

<script>
  function initMobilePostCards() {
    const cards = document.querySelectorAll<HTMLElement>(".mobile-tap-card");

    for (const card of cards) {
      if (card.dataset.cardBound === "true") continue;

      card.dataset.cardBound = "true";

      card.addEventListener("click", event => {
        if (!window.matchMedia("(max-width: 899px)").matches) return;

        const target = event.target as HTMLElement;
        const url = card.dataset.postUrl;

        if (!url) return;

        if (target.closest("a")) return;

        window.location.href = url;
      });
    }
  }

  initMobilePostCards();
  document.addEventListener("astro:after-swap", initMobilePostCards);
</script>

<style>
  .post-card {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .post-content {
    flex: 1;
    min-width: 0;
  }

  .post-cover {
    width: 280px;
    height: 200px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 10px;
  }

  @media (max-width: 639px) {
    .post-card {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .post-cover {
      width: 280px;
      height: 200px;
    }
  }
</style>
