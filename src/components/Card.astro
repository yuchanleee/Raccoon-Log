---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import IconCategory from "@/assets/icons/IconCategory.svg";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, category, cover, ...props } = data;

const lowestCategory = category.at(-1);
---

<li class="border-border my-8 border-b pb-8 last:border-b-0">
  <div class="post-card">
    <div class="post-content">
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class:list={[
          "text-accent inline-block text-xl font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading transition:name={toTransitionName(id)}>
          {title}
        </Heading>
      </a>

      <div class="mt-1 mb-2 flex items-center gap-5">
        <Datetime {...props} />

        {
          lowestCategory && (
            <span class="text-muted-foreground flex items-center gap-1">
              <IconCategory class="size-5" />
              <span class="text-sm">{lowestCategory}</span>
            </span>
          )
        }
      </div>

      <p>{description}</p>
    </div>

    {cover && <img src={cover.src} alt="" class="post-cover" />}
  </div>
</li>

<style>
  .post-card {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .post-content {
    flex: 1;
    min-width: 0;
  }

  .post-cover {
    width: 240px;
    height: 150px;

    flex-shrink: 0;
    object-fit: cover;

    border-radius: 10px;
  }

  @media (max-width: 639px) {
    .post-card {
      flex-direction: column;
      gap: 1rem;
    }

    .post-cover {
      width: 100%;
      height: 220px;
    }
  }
</style>
